# Copy to .env.local (git-ignored) and adjust. Only EXPO_PUBLIC_* variables reach the app,
# and they are bundled into the binary — never put secrets here.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Full backend URL. Leave empty in development to auto-detect:
#   iOS simulator → http://localhost:5000
#   Android emulator → http://10.0.2.2:5000
#   Physical device (Expo Go / dev build) → http://<your-LAN-IP>:5000 (taken from Metro)
EXPO_PUBLIC_API_URL=

# Backend port used by the auto-detection above.
EXPO_PUBLIC_DEV_API_PORT=5000
