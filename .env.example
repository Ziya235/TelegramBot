# Copy to .env in the repository root. Never commit .env.
# Values below are placeholders. Set the real values in Render for production.

# Pooled Neon/Postgres connection used by the API at runtime.
DATABASE_URL=

# Direct Postgres connection used by Prisma. Falls back to DATABASE_URL when unset.
DIRECT_URL=

# Secret used to sign authentication tokens.
JWT_SECRET=

# Optional. Render sets PORT in production. The local API default is 5000.
# PORT=5000

# Frontend production API URL is already set in frontend/.env.production
# as the public VITE_API_URL. Do not put secrets in that file.

# Telegram code bot. The sports API still starts if these are missing; the bot stays off.
# Paste real values into .env only. Never commit .env.
OPENAI_API_KEY=sk-your-secret-key
# Optional. Defaults to gpt-4o-mini when unset. Chat replies are not the code-change path.
OPENAI_MODEL=gpt-4o-mini
# From BotFather. Shape: 123456789:AAH...
TELEGRAM_BOT_TOKEN=123456789:your-bot-token
# Your numeric Telegram user id. The bot replies with it when you send /id.
# Several ids can be separated by commas. Nobody else can change the code.
TELEGRAM_ALLOWED_USER_IDS=123456789
# Cursor user API key from https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_your_key
# Optional. Defaults to composer-2.5.
CURSOR_MODEL=composer-2.5
# GitHub token that can open and merge pull requests on this repo.
GITHUB_TOKEN=github_pat_your_token
# Optional. Defaults to Ziya235/TelegramBot.
GITHUB_REPOSITORY=Ziya235/TelegramBot
# Required on Render (webhook mode). 1-256 letters, numbers, underscore, or hyphen.
# Not required for local polling.
TELEGRAM_WEBHOOK_SECRET=
# Optional public https origin, without a path.
# On Render, leave this unset and RENDER_EXTERNAL_URL is used instead.
# TELEGRAM_WEBHOOK_URL=
