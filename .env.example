# Copy to .env in the repository root. Never commit .env.
# Values below are placeholders. Set the real values in Render for production.

# Pooled Neon/Postgres connection used by the API at runtime.
DATABASE_URL=

# Direct Postgres connection used by Prisma. Falls back to DATABASE_URL when unset.
DIRECT_URL=

# Secret used to sign authentication tokens.
JWT_SECRET=

# Optional. Render sets PORT in production. The local API default is 5000.
# PORT=5000

# Frontend production API URL is already set in frontend/.env.production
# as the public VITE_API_URL. Do not put secrets in that file.

# Telegram AI bot. The sports API still starts if these are missing; the bot stays off.
# Create the key at https://platform.openai.com/api-keys
# An API key does not include free credit. The OpenAI account needs billing or credits.
# Paste the real sk-... secret key into .env only. A tracking ID is not used.
OPENAI_API_KEY=sk-your-secret-key
# Optional. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=gpt-4o-mini
# From BotFather. Shape: 123456789:AAH...  Paste the real token into .env only.
TELEGRAM_BOT_TOKEN=123456789:your-bot-token
# Required on Render (webhook mode). 1-256 letters, numbers, underscore, or hyphen.
# Not required for local polling.
TELEGRAM_WEBHOOK_SECRET=
# Optional public https origin, without a path.
# On Render, leave this unset and RENDER_EXTERNAL_URL is used instead.
# TELEGRAM_WEBHOOK_URL=
