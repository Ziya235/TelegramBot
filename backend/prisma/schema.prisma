generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  dateOfBirth  DateTime
  bio          String?
  workplace    String?
  school       String?
  image        String?
  role         UserRole @default(USER)

  gamesPlayed Int @default(0)
  goals       Int @default(0)
  assists     Int @default(0)

  permissions   UserPermission[]
  leagues       League[]
  players       Player[]
  leagueMembers LeagueMember[]

  captainedTeams Team[] @relation("TeamCaptain")

  leagueTeamInvitesSent     LeagueTeamInvite[]    @relation("LeagueTeamInviteSender")
  leagueJoinRequests        LeagueJoinRequest[]   @relation("LeagueJoinRequester")
  challengesCreated         Challenge[]           @relation("ChallengeCreator")
  challengeRequests         ChallengeRequest[]    @relation("ChallengeRequester")
  playerSearchesCreated     PlayerSearch[]        @relation("PlayerSearchCreator")
  playerSearchRequests      PlayerSearchRequest[] @relation("PlayerSearchRequester")
  friendliesCreated         Match[]               @relation("FriendlyCreator")
  championshipsCreated      Championship[]        @relation("ChampionshipCreator")
  championshipTeamInvitesSent ChampionshipTeamInvite[] @relation("ChampionshipTeamInviteSender")
  championshipJoinRequests  ChampionshipJoinRequest[] @relation("ChampionshipJoinRequester")
  teamPlayerInvitesReceived TeamPlayerInvite[]    @relation("TeamPlayerInvitee")
  teamPlayerInvitesSent     TeamPlayerInvite[]    @relation("TeamPlayerInviter")

  friendRequestsSent     FriendRequest[]           @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[]           @relation("FriendRequestReceiver")
  friendshipsAsUser1     Friendship[]              @relation("FriendshipUser1")
  friendshipsAsUser2     Friendship[]              @relation("FriendshipUser2")
  notifications          Notification[]            @relation("NotificationUser")
  notificationsActed     Notification[]            @relation("NotificationActor")
  conversationParticipants ConversationParticipant[]
  messagesSent           Message[]                 @relation("MessageSender")
  messageReadReceipts    MessageReadReceipt[]

  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  NEW_MESSAGE
  TEAM_INVITE
  LEAGUE_INVITE
  MATCH_INVITE
  JOIN_REQUEST
  CHAMPIONSHIP_INVITE
  CHAMPIONSHIP_JOIN_REQUEST
}

enum ConversationType {
  DIRECT
  GROUP
  TEAM
  LEAGUE
}

model FriendRequest {
  id         Int           @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     RequestStatus @default(PENDING)

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Friendship {
  id      Int @id @default(autoincrement())
  user1Id Int
  user2Id Int

  user1 User @relation("FriendshipUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("FriendshipUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Notification {
  id       Int              @id @default(autoincrement())
  userId   Int
  actorId  Int?
  type     NotificationType
  entityId String?
  isRead   Boolean          @default(false)

  user  User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Conversation {
  id   Int              @id @default(autoincrement())
  type ConversationType @default(DIRECT)

  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model ConversationParticipant {
  id             Int       @id @default(autoincrement())
  conversationId Int
  userId         Int
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id              Int       @id @default(autoincrement())
  conversationId  Int
  senderId        Int
  content         String
  clientMessageId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  readReceipts MessageReadReceipt[]

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
}

model MessageReadReceipt {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model Permission {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String?

  users UserPermission[]
}

model UserPermission {
  id           Int @id @default(autoincrement())
  userId       Int
  permissionId Int

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

enum LeagueStatus {
  DRAFT
  ACTIVE
  FINISHED
  CANCELLED
}

enum LeagueVisibility {
  PUBLIC
  PRIVATE
}

model Sport {
  id        Int     @id @default(autoincrement())
  name      String
  code      String  @unique
  isEnabled Boolean @default(false)

  leagues        League[]
  championships  Championship[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model League {
  id          Int              @id @default(autoincrement())
  name        String
  logo        String?
  season      String?
  description String?
  visibility  LeagueVisibility @default(PRIVATE)
  status      LeagueStatus     @default(DRAFT)
  matchFormat ChampionshipMatchFormat @default(SINGLE)

  sportId     Int
  createdById Int

  sport     Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Cascade)

  teams        LeagueTeam[]
  members      LeagueMember[]
  matches      Match[]
  teamInvites  LeagueTeamInvite[]
  joinRequests LeagueJoinRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  shortName      String?
  logo           String?
  description    String?
  city           String?
  primaryColor   String?
  secondaryColor String?
  foundedYear    Int?

  captainId Int
  captain   User @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Restrict)

  players           Player[]
  leagueMemberships LeagueTeam[]
  championshipTeams   ChampionshipTeam[]
  championshipInvites ChampionshipTeamInvite[]
  championshipJoinRequests ChampionshipJoinRequest[]
  groupTeams          ChampionshipGroupTeam[]
  wonMatches        Match[] @relation("MatchWinner")

  homeMatches Match[]      @relation("HomeTeam")
  awayMatches Match[]      @relation("AwayTeam")
  matchEvents MatchEvent[] @relation("EventTeam")

  teamInvites            LeagueTeamInvite[]
  joinRequests           LeagueJoinRequest[]
  challenges             Challenge[]         @relation("ChallengeTeam")
  acceptedChallenges     Challenge[]         @relation("ChallengeAcceptedTeam")
  challengeRequests      ChallengeRequest[]
  playerSearchesHost     PlayerSearch[]      @relation("PlayerSearchHost")
  playerSearchesOpponent PlayerSearch[]      @relation("PlayerSearchOpponent")
  playerInvites          TeamPlayerInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeagueTeam {
  id       Int @id @default(autoincrement())
  leagueId Int
  teamId   Int

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([leagueId, teamId])
  @@index([teamId])
}

model Player {
  id          Int     @id @default(autoincrement())
  firstName   String
  lastName    String
  position    String?
  shirtNumber Int?
  photo       String?
  description String?

  teamId Int
  userId Int?

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  matchEvents  MatchEvent[] @relation("EventPlayer")
  assistEvents MatchEvent[] @relation("EventAssist")
  subInEvents  MatchEvent[] @relation("EventPlayerIn")
  subOutEvents MatchEvent[] @relation("EventPlayerOut")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamPlayerInvite {
  id            Int           @id @default(autoincrement())
  teamId        Int
  invitedUserId Int
  invitedById   Int
  status        RequestStatus @default(PENDING)
  position      String?
  shirtNumber   Int?
  message       String?
  respondedAt   DateTime?

  team        Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedUser User @relation("TeamPlayerInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User @relation("TeamPlayerInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitedUserId, status])
  @@index([invitedById, status])
  @@index([teamId, status])
}

enum MatchType {
  LEAGUE
  FRIENDLY
  CHAMPIONSHIP
}

enum MatchStage {
  GROUP_STAGE
  PRELIMINARY
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  FINAL
}

enum ChampionshipStatus {
  DRAFT
  REGISTRATION
  GROUP_STAGE
  PLAYOFF
  COMPLETED
  FINISHED
  CANCELLED
}

enum ChampionshipFormat {
  GROUP_AND_PLAYOFF
  PLAYOFF_ONLY
}

enum ChampionshipMatchFormat {
  SINGLE
  HOME_AWAY
}

enum ChampionshipVisibility {
  PUBLIC
  PRIVATE
}

model Championship {
  id          Int                 @id @default(autoincrement())
  name        String
  description String?
  logo        String?
  format      ChampionshipFormat  @default(GROUP_AND_PLAYOFF)
  matchFormat ChampionshipMatchFormat @default(SINGLE)
  visibility  ChampionshipVisibility @default(PRIVATE)
  status      ChampionshipStatus  @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  maxTeams    Int?
  /// Default how many teams qualify from each group (can be overridden per group)
  defaultQualifyCount Int         @default(2)

  sportId     Int
  createdById Int

  sport     Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)
  createdBy User  @relation("ChampionshipCreator", fields: [createdById], references: [id], onDelete: Cascade)

  teams       ChampionshipTeam[]
  teamInvites ChampionshipTeamInvite[]
  joinRequests ChampionshipJoinRequest[]
  groups      ChampionshipGroup[]
  matches     Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sportId, status])
  @@index([createdById])
}

model ChampionshipTeam {
  id             Int @id @default(autoincrement())
  championshipId Int
  teamId         Int

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([championshipId, teamId])
  @@index([teamId])
}

model ChampionshipTeamInvite {
  id          Int           @id @default(autoincrement())
  championshipId Int
  teamId      Int
  invitedById Int
  status      RequestStatus @default(PENDING)
  message     String?
  respondedAt DateTime?

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("ChampionshipTeamInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, status])
  @@index([championshipId, status])
}

model ChampionshipJoinRequest {
  id            Int           @id @default(autoincrement())
  championshipId Int
  teamId        Int
  requestedById Int
  status        RequestStatus @default(PENDING)
  message       String?
  respondedAt   DateTime?

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ChampionshipJoinRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([championshipId, status])
  @@index([teamId, status])
}

model ChampionshipGroup {
  id             Int    @id @default(autoincrement())
  championshipId Int
  name           String
  /// Planned capacity; null = flexible
  teamSlots      Int?
  qualifyCount   Int    @default(2)
  sortOrder      Int    @default(0)

  championship Championship            @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  teams        ChampionshipGroupTeam[]
  matches      Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([championshipId, name])
  @@index([championshipId, sortOrder])
}

model ChampionshipGroupTeam {
  id      Int @id @default(autoincrement())
  groupId Int
  teamId  Int
  /// Seed / assignment order within the group
  seed    Int @default(0)

  group ChampionshipGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  team  Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([groupId, teamId])
  @@index([teamId])
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
  POSTPONED
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  NOTE
}

model Match {
  id             Int          @id @default(autoincrement())
  leagueId       Int?
  championshipId Int?
  groupId        Int?
  homeTeamId     Int
  awayTeamId     Int
  winnerTeamId   Int?
  round          Int?
  stage          MatchStage?
  matchType      MatchType    @default(LEAGUE)
  status         MatchStatus  @default(SCHEDULED)
  scheduledAt    DateTime?
  location       String?
  venue          String?
  notes          String?
  homeScore      Int          @default(0)
  awayScore      Int          @default(0)
  minute         Int?
  startedAt      DateTime?
  finishedAt     DateTime?
  reopenedAt     DateTime?
  lockedAt       DateTime?
  editUntil      DateTime?
  createdById    Int?
  statsApplied   Boolean      @default(false)

  league       League?            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  championship Championship?      @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  group        ChampionshipGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  homeTeam     Team               @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam     Team               @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  winnerTeam   Team?              @relation("MatchWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("FriendlyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  events       MatchEvent[]
  challenge    Challenge?
  playerSearch PlayerSearch?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leagueId, status])
  @@index([leagueId, scheduledAt])
  @@index([championshipId, status])
  @@index([championshipId, stage])
  @@index([groupId, status])
  @@index([scheduledAt, status])
  @@index([matchType, status])
  @@index([status, editUntil])
}

model MatchEvent {
  id             Int            @id @default(autoincrement())
  matchId        Int
  type           MatchEventType
  minute         Int
  teamId         Int?
  playerId       Int?
  assistPlayerId Int?
  playerInId     Int?
  playerOutId    Int?
  note           String?

  match        Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team         Team?   @relation("EventTeam", fields: [teamId], references: [id], onDelete: SetNull)
  player       Player? @relation("EventPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  assistPlayer Player? @relation("EventAssist", fields: [assistPlayerId], references: [id], onDelete: SetNull)
  playerIn     Player? @relation("EventPlayerIn", fields: [playerInId], references: [id], onDelete: SetNull)
  playerOut    Player? @relation("EventPlayerOut", fields: [playerOutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([matchId, minute])
  @@index([playerId])
  @@index([assistPlayerId])
}

enum LeagueMemberRole {
  PLAYER
  VIEWER
  MANAGER
  ADMIN
}

model LeagueMember {
  id       Int              @id @default(autoincrement())
  leagueId Int
  userId   Int
  role     LeagueMemberRole @default(PLAYER)

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueId, userId])
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model LeagueTeamInvite {
  id          Int           @id @default(autoincrement())
  leagueId    Int
  teamId      Int
  invitedById Int
  status      RequestStatus @default(PENDING)
  message     String?
  respondedAt DateTime?

  league    League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team      Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("LeagueTeamInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, status])
  @@index([leagueId, status])
}

model LeagueJoinRequest {
  id            Int           @id @default(autoincrement())
  leagueId      Int
  teamId        Int
  requestedById Int
  status        RequestStatus @default(PENDING)
  message       String?
  respondedAt   DateTime?

  league      League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("LeagueJoinRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leagueId, status])
  @@index([teamId, status])
}

enum ChallengeStatus {
  OPEN
  ACCEPTED
  CANCELLED
  EXPIRED
}

model Challenge {
  id             Int             @id @default(autoincrement())
  teamId         Int
  createdById    Int
  scheduledAt    DateTime
  venue          String
  notes          String?
  status         ChallengeStatus @default(OPEN)
  acceptedTeamId Int?
  matchId        Int?            @unique

  team         Team               @relation("ChallengeTeam", fields: [teamId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedTeam Team?              @relation("ChallengeAcceptedTeam", fields: [acceptedTeamId], references: [id], onDelete: SetNull)
  match        Match?             @relation(fields: [matchId], references: [id], onDelete: SetNull)
  requests     ChallengeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([teamId, status])
}

model ChallengeRequest {
  id            Int           @id @default(autoincrement())
  challengeId   Int
  teamId        Int
  requestedById Int
  status        RequestStatus @default(PENDING)
  message       String?
  respondedAt   DateTime?

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("ChallengeRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challengeId, teamId])
  @@index([challengeId, status])
}

enum PlayerSearchStatus {
  OPEN
  FULL
  CANCELLED
  EXPIRED
}

model PlayerSearch {
  id             Int                @id @default(autoincrement())
  hostTeamId     Int
  createdById    Int
  opponentTeamId Int?
  scheduledAt    DateTime
  venue          String
  notes          String?
  playersNeeded  Int
  playersFilled  Int                @default(0)
  status         PlayerSearchStatus @default(OPEN)
  matchId        Int?               @unique

  hostTeam     Team                  @relation("PlayerSearchHost", fields: [hostTeamId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation("PlayerSearchCreator", fields: [createdById], references: [id], onDelete: Cascade)
  opponentTeam Team?                 @relation("PlayerSearchOpponent", fields: [opponentTeamId], references: [id], onDelete: SetNull)
  match        Match?                @relation(fields: [matchId], references: [id], onDelete: SetNull)
  requests     PlayerSearchRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([hostTeamId, status])
}

model PlayerSearchRequest {
  id             Int           @id @default(autoincrement())
  playerSearchId Int
  userId         Int
  status         RequestStatus @default(PENDING)
  message        String?
  respondedAt    DateTime?

  playerSearch PlayerSearch @relation(fields: [playerSearchId], references: [id], onDelete: Cascade)
  user         User         @relation("PlayerSearchRequester", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerSearchId, userId])
  @@index([playerSearchId, status])
}
